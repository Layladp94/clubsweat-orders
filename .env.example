# ---- Supabase (project settings -> API) ----
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- WhatsApp Cloud API (Meta developer app -> WhatsApp -> API setup) ----
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=            # permanent System User token
WA_VERIFY_TOKEN=clubsweat-verify   # any string; paste the same one in Meta webhook config
WA_APP_SECRET=              # Meta app -> Settings -> Basic -> App secret (used to verify webhook signatures)

# ---- Yoco (portal -> Sell online -> Payment gateway) ----
YOCO_SECRET_KEY=sk_test_...
YOCO_WEBHOOK_SECRET=whsec_...   # returned when you register the webhook (see docs/INSTALL.md)

# ---- App ----
PUBLIC_FUNCTIONS_URL=https://YOUR_PROJECT_REF.supabase.co/functions/v1
BAR_PHONE=27XXXXXXXXX        # staff phone that receives order alerts (digits only, country code first)
CRON_SECRET=                 # random string; renewals function requires it
ANTHROPIC_API_KEY=           # optional: enables free-text order parsing
